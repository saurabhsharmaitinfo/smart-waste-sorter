{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"125kfQ5gHMtJrB7E0MVF8clFzxOyHnVun","timestamp":1752318811117}],"mount_file_id":"1cXDMgbKbiYTqIloH6UFWOpVZ9jkIJIbv","authorship_tag":"ABX9TyP2SzR7IF6i8dZn9Fl7XJMO"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["**Albumentations** is a Python library for image augmentation, commonly used in computer vision to artificially increase dataset size by applying transformations like rotation, flipping, and brightness adjustments. It’s fast, easy to use, and works well with TensorFlow/PyTorch. Below, I’ll guide you through augmenting your ~100 images per class to ~1,000 images per class, assuming you have a dataset ready (either manually collected or from TrashNet)."],"metadata":{"id":"kjEN_ggiMCqb"}},{"cell_type":"code","source":["#!pip install albumentations\n","#!pip install opencv-python"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bAnYwoShZ7QO","executionInfo":{"status":"ok","timestamp":1752322024166,"user_tz":-330,"elapsed":6625,"user":{"displayName":"Saurabh Sharma","userId":"01447876818410327932"}},"outputId":"7bd9917e-0eaf-4609-d143-3455677f0656"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Requirement already satisfied: opencv-python in /usr/local/lib/python3.11/dist-packages (4.11.0.86)\n","Requirement already satisfied: numpy>=1.21.2 in /usr/local/lib/python3.11/dist-packages (from opencv-python) (2.0.2)\n"]}]},{"cell_type":"code","source":["import os\n","import cv2\n","import numpy as np\n","import albumentations as A\n","from pathlib import Path\n","\n","# Define augmentation pipeline\n","transform = A.Compose([\n","    A.Rotate(limit=30, p=0.5),  # Rotate by up to ±30 degrees with 50% probability\n","    A.HorizontalFlip(p=0.5),    # Flip horizontally with 50% probability\n","    A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.2, p=0.5),\n","    A.RandomCrop(height=200, width=200, p=0.3),  # Random crop with 30% probability\n","    A.Resize(height=224, width=224),  # Ensure output size is 224x224\n","])\n","\n","# Paths\n","DATA_DIR = '/content/drive/MyDrive/Projects/Smart Waste Sorting/Dataset/subset_data'  # Root folder with subfolders: plastic/, organic/, etc.\n","OUTPUT_DIR = '/content/drive/MyDrive/Projects/Smart Waste Sorting/Dataset/subset_data/augmented_data/'  # Where augmented images will be saved\n","CLASSES = ['cardboard', 'glass', 'metal', 'paper', 'plastic', 'trash']\n","TARGET_COUNT = 1000  # Target number of images per class\n","\n","def augment_images():\n","    for class_name in CLASSES:\n","        input_dir = Path(DATA_DIR) / class_name\n","        output_dir = Path(OUTPUT_DIR) / class_name\n","        output_dir.mkdir(parents=True, exist_ok=True)\n","\n","        # Get list of original images\n","        images = list(input_dir.glob('*.jpg')) + list(input_dir.glob('*.png'))\n","        num_original = len(images)\n","        if num_original == 0:\n","            print(f\"No images found in {input_dir}\")\n","            continue\n","\n","        # Calculate how many augmentations per image\n","        augmentations_per_image = (TARGET_COUNT // num_original) + 1\n","\n","        count = 0\n","        for img_path in images:\n","            img = cv2.imread(str(img_path))\n","            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)  # Convert to RGB\n","\n","            # Generate augmented images\n","            for i in range(augmentations_per_image):\n","                if count >= TARGET_COUNT:\n","                    break\n","                augmented = transform(image=img)['image']\n","                output_path = output_dir / f\"{class_name}_{count:04d}.jpg\"\n","                cv2.imwrite(str(output_path), cv2.cvtColor(augmented, cv2.COLOR_RGB2BGR))\n","                count += 1\n","\n","        print(f\"Generated {count} images for {class_name}\")\n","\n","if __name__ == \"__main__\":\n","    augment_images()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6K2K9VBNV-ge","executionInfo":{"status":"ok","timestamp":1752326103449,"user_tz":-330,"elapsed":97006,"user":{"displayName":"Saurabh Sharma","userId":"01447876818410327932"}},"outputId":"e565b446-43b5-4dae-ad47-97a9da53f225"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Generated 1000 images for cardboard\n","Generated 1000 images for glass\n","Generated 1000 images for metal\n","Generated 1000 images for paper\n","Generated 1000 images for plastic\n","Generated 1000 images for trash\n"]}]}]}