{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"125kfQ5gHMtJrB7E0MVF8clFzxOyHnVun","timestamp":1752318811117}],"mount_file_id":"1XxAKncW-WcBIRiRtAYyOhEW6glmV2kZN","authorship_tag":"ABX9TyOUTIxUPchJqZ/qQEGtM/a9"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["**This code is to create a CSV file for the dataset.**"],"metadata":{"id":"kjEN_ggiMCqb"}},{"cell_type":"code","source":["import pandas as pd\n","from pathlib import Path\n","\n","OUTPUT_DIR = '/content/drive/MyDrive/Projects/Smart Waste Sorting/Dataset/subset_data/augmented_data/'\n","CLASSES = ['cardboard', 'glass', 'metal', 'paper', 'plastic', 'trash']\n","data = []\n","\n","for class_name in CLASSES:\n","    images = list(Path(OUTPUT_DIR).joinpath(class_name).glob('*.jpg'))\n","    for img in images:\n","        data.append({'image_path': str(img), 'label': class_name})\n","\n","df = pd.DataFrame(data)\n","df.to_csv('/content/drive/MyDrive/Projects/Smart Waste Sorting/Dataset/subset_data/augmented_data/dataset.csv', index=False)\n","print(f\"CSV file created successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6K2K9VBNV-ge","executionInfo":{"status":"ok","timestamp":1752326517437,"user_tz":-330,"elapsed":189,"user":{"displayName":"Saurabh Sharma","userId":"01447876818410327932"}},"outputId":"301d3f71-9baa-49c8-93f4-bcd623562632"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["CSV file created successfully.\n"]}]}]}