{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"125kfQ5gHMtJrB7E0MVF8clFzxOyHnVun","timestamp":1752318811117}],"mount_file_id":"1qpfYx7EuxX0V664buTNCASoJ2bJjy-mY","authorship_tag":"ABX9TyOtY6EqB54bFB9EhBtvlYQJ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["**This code is to copy randomly choosen 100 images per category/class, to prepare the training data for our model.**"],"metadata":{"id":"kjEN_ggiMCqb"}},{"cell_type":"code","source":["import os\n","import random\n","from shutil import copyfile\n","from pathlib import Path\n","\n","DATA_DIR = '/content/drive/MyDrive/Projects/Smart Waste Sorting/Dataset/TrashNet Dataset'\n","OUTPUT_DIR = '/content/drive/MyDrive/Projects/Smart Waste Sorting/Dataset/subset_data/'\n","CLASSES = ['cardboard', 'glass', 'metal', 'paper', 'plastic', 'trash']\n","NUM_IMAGES = 100\n","\n","for class_name in CLASSES:\n","    input_dir = Path(DATA_DIR) / class_name\n","    output_dir = Path(OUTPUT_DIR) / class_name\n","    output_dir.mkdir(parents=True, exist_ok=True)\n","    images = list(input_dir.glob('*.jpg')) + list(input_dir.glob('*.png'))\n","    selected = random.sample(images, min(NUM_IMAGES, len(images)))\n","    for img in selected:\n","        copyfile(img, output_dir / img.name)\n","    print(f\"Copied {NUM_IMAGES} images for {class_name}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6K2K9VBNV-ge","executionInfo":{"status":"ok","timestamp":1752325318486,"user_tz":-330,"elapsed":16045,"user":{"displayName":"Saurabh Sharma","userId":"01447876818410327932"}},"outputId":"0a2c08e4-4480-40f2-e0f9-033badea180f"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Copied 100 images for cardboard\n","Copied 100 images for glass\n","Copied 100 images for metal\n","Copied 100 images for paper\n","Copied 100 images for plastic\n","Copied 100 images for trash\n"]}]}]}